{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sodobmhc/schemas/person.schema.json",
  "title": "Person",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "source_ids", "last_verified"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "person" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi"],
      "properties": {
        "vi": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position_id", "organization_id", "from"],
        "properties": {
          "position_id": { "type": "string" },
          "organization_id": { "type": "string" },
          "from": { "type": "string", "format": "date" },
          "to": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "last_verified": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
