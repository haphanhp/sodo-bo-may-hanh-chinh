{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sodobmhc/schemas/facility.schema.json",
  "title": "Facility",
  "// PROPOSED": "Schema này CHƯA được user duyệt chi tiết — đây là bản hợp lý dựa theo pattern các schema khác, cần user xác nhận lại trước khi dùng chính thức ở Phase 10.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "organization_id"],
  "properties": {
    "id": { "type": "string" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi"],
      "properties": {
        "vi": { "type": "string" }
      }
    },
    "type": {
      "type": "string",
      "enum": ["headquarters", "branch", "reception_point", "other"]
    },
    "organization_id": { "type": "string" },
    "address": { "type": "string" },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": { "type": "array", "items": { "type": "string" } },
        "email": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "effective_from": { "type": ["string", "null"], "format": "date" },
    "effective_to": { "type": ["string", "null"], "format": "date" },
    "notes": { "type": "string" }
  }
}
