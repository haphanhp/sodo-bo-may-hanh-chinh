{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sodobmhc/schemas/organization.schema.json",
  "title": "Organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "status", "jurisdiction", "source_ids", "last_verified"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "national_assembly",
        "state_president_office",
        "government",
        "supreme_court",
        "supreme_procuracy",
        "ministry",
        "ministry_level_agency",
        "provincial",
        "district",
        "commune",
        "other"
      ]
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi"],
      "properties": {
        "vi": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "short_name": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "merged", "dissolved", "renamed", "upgraded"]
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["national", "provincial", "district", "commune"]
    },
    "parent_id": { "type": ["string", "null"] },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string" },
        "phone": { "type": "array", "items": { "type": "string" } },
        "email": { "type": "array", "items": { "type": "string" } },
        "website": { "type": "array", "items": { "type": "string" } }
      }
    },
    "leadership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position_id", "person_id"],
        "properties": {
          "position_id": { "type": "string" },
          "person_id": { "type": ["string", "null"] }
        }
      }
    },
    "functions": { "type": "array", "items": { "type": "string" } },
    "powers": { "type": "array", "items": { "type": "string" } },
    "responsibilities": { "type": "array", "items": { "type": "string" } },
    "units": { "type": "array", "items": { "type": "string" } },
    "procedures": { "type": "array", "items": { "type": "string" } },
    "documents": { "type": "array", "items": { "type": "string" } },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "effective_from": { "type": ["string", "null"], "format": "date" },
    "effective_to": { "type": ["string", "null"], "format": "date" },
    "last_verified": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
