{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sodobmhc/schemas/license.schema.json",
  "title": "License",
  "description": "Dùng chung cho 3 file data: licenses.json, certificates.json, forms.json — phân biệt bằng field 'type'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "source_ids"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "enum": ["license", "certificate", "form"] },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi"],
      "properties": {
        "vi": { "type": "string" }
      }
    },
    "issuing_organization_id": { "type": "string" },
    "procedure_id": { "type": "string" },
    "validity": { "type": "string" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "legal_basis": { "type": "array", "items": { "type": "string" } },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  }
}
