{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sodobmhc/schemas/procedure.schema.json",
  "title": "Procedure",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "status", "source_ids"],
  "properties": {
    "id": { "type": "string" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi"],
      "properties": {
        "vi": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["active", "deprecated"] },
    "applicant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": { "type": "string", "enum": ["individual", "organization"] }
        }
      }
    },
    "responsible_organization_id": { "type": "string" },
    "receiving_organization_id": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "name", "actor", "description", "duration"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer" },
          "name": { "type": "string" },
          "actor": { "type": "string", "enum": ["applicant", "organization"] },
          "organization_id": { "type": "string" },
          "description": { "type": "string" },
          "required_documents": { "type": "array", "items": { "type": "string" } },
          "duration": { "type": "string" }
        }
      }
    },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "fees": { "type": "array", "items": { "type": "string" } },
    "result": { "type": "array", "items": { "type": "string" } },
    "forms": { "type": "array", "items": { "type": "string" } },
    "legal_basis": { "type": "array", "items": { "type": "string" } },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "last_verified": { "type": "string", "format": "date" }
  }
}
