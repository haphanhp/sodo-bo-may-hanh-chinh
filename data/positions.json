  {
    "id": "position-chu-tich-nuoc",
    "name": {
      "vi": "Chủ tịch nước"
    },
    "organization_type": "state",
    "level": "head_of_state",
    "functions": [
      "Nguyên thủ quốc gia, thay mặt nước CHXHCN Việt Nam về đối nội và đối ngoại",
      "Thống lĩnh lực lượng vũ trang nhân dân",
      "Công bố Hiến pháp, luật, pháp lệnh",
      "Bổ nhiệm, miễn nhiệm các chức danh do Hiến pháp quy định"
    ],
    "powers": [],
    "responsibilities": [],
    "legal_basis": [
      "Điều 86–87 Hiến pháp 2013"
    ],
    "source_ids": [
      "source-008"
    ],
    "notes": "Là CHỨC VỤ do Quốc hội bầu, không phải tổ chức tập thể. Bộ máy giúp việc là Văn phòng Chủ tịch nước (org-vpctn-vn)."
